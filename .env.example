# Copy to .env and fill in. Never commit .env.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Shared secret for the web UI / clients. Required when the server is reachable from the internet.
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
APP_TOKEN=
# Server deploy only: your domain, e.g. saydar.ai (DNS A-record → server IP)
DOMAIN=
